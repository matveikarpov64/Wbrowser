# 🔴 Real login data — never commit this.
# Runtime state now defaults to the OS state directory, not the repo,
# but these stay here as a second line of defence.
.wbrowser/
*.session.json
session.json
wbrowser-session.json
runtime.json

# Logs (they contain visited URLs)
*.log

# Local job definitions.
# 🔴 Allow-list, not deny-list: a job file names the sites you automate and the
#    selectors you click. That is your routine, so the default is "not published".
#    Only the shipped examples are tracked.
jobs/*
!jobs/example-*.json

# Secrets and local tool config
.env
.env.*
!.env.example
.claude/
.mcp.json

# Scratch space
scratchpad/
tmp/

node_modules/
package-lock.json
.DS_Store

# Python bytecode — leaked into the first commit before this line existed
__pycache__/
*.py[cod]

# Harness agent workspace — never publish
AGENT/
